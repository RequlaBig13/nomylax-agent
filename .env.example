# Shared secret expected in Authorization: Bearer <AGENT_API_KEY>
AGENT_API_KEY=

# Public Devnet recipient used only by this reference agent's proposed intents.
# Use any public Devnet wallet address created for demos. It does not need private-key access.
AGENT_RECIPIENT=

# Optional. If set, Claude generates the intent mix.
# If not set or unavailable, the service returns a deterministic reference mix.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
